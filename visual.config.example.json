{
  "baseUrl": "https://example.com",
  "outputDir": ".visual-tests",
  "threshold": 0.01,
  "pixelSensitivity": 0.1,
  "viewports": ["mobile-m", "tablet", "desktop-l"],
  "pages": [
    {
      "name": "homepage",
